# KlipperAI runtime configuration
#
# Copy or adapt this file into printer_data/config/klipperai/klipperai.cfg on a host install.
# It is designed to be editable from Mainsail.
#
# Notes:
# - Restart klipperai-agent after editing this file.
# - Hidden install metadata is stored in `/etc/klipperai/klipperai.env`.
# - API keys use encrypted private storage; never put keys in this file or the environment file.

[install]
printer_data_root: /home/pi/printer_data  # Printer data root. Example: /home/pi/printer_data
mainsail_config_dir: /home/pi/printer_data/config  # Config dir that contains the managed klipperai/ folder. Example: /home/pi/printer_data/config

[printer_identity]
firmware_flavor:  # Main firmware flavor. Examples: Kalico, Klipper
firmware_version:  # Firmware version string. Examples: v2026.05.00-4, v0.13.0-221
host_model:  # Host computer / SBC model. Examples: BigTreeTech CB1, Raspberry Pi 4 Model B
host_distribution:  # Linux distribution on the host. Examples: Debian GNU/Linux 11 (bullseye) 11, Armbian 24.2 Bookworm
mainboard:  # Printer controller board model. Examples: BTT Manta E3EZ, BTT Octopus Pro
toolhead:  # Toolhead board / electronics model. Examples: BTT EBB36, FYSETC H36 Combo, Orbiter Nitehawk

[printer_capabilities]
probe_type: none  # Probe family. Examples: none, bltouch, beacon, eddy
accelerometer: none  # Accelerometer family. Examples: none, adxl345, lis2dw
filament_sensor: none  # Filament sensor family. Examples: none, switch, motion
bed_mesh_configured: false  # Whether bed mesh is configured. Examples: true, false
input_shaper_configured: false  # Whether input shaper is configured. Examples: true, false
canbus_enabled: false  # Whether the printer uses CAN anywhere. Examples: true, false
addons:  # Comma-separated addons. Examples: OctoEverywhere, KAMP, KlipperScreen

[config_context]
root_config_file:  # Root Klipper config entry point. Examples: printer.cfg, machines/voron/printer-main.cfg
ignore_globs:  # Comma-separated exclude globs. Examples: backups/**, archive/**, timelapse/**

[server]
port: 8811  # Local agent port. Examples: 8811, 9911
root_path: /klipperai  # Public reverse-proxy path. Examples: /klipperai, /ai
data_dir: /var/lib/klipperai  # Local runtime data directory. Examples: /var/lib/klipperai, /srv/klipperai/data
checkpoint_db: /var/lib/klipperai/checkpoints.sqlite  # Legacy reserved path; investigation storage uses data_dir/investigations.sqlite3. Examples: /var/lib/klipperai/checkpoints.sqlite, /srv/klipperai/checkpoints.sqlite
enable_write_actions: false  # Compatibility setting; runtime always keeps printer writes disabled.

[security]
security_allowed_hosts: *  # Optional printer/proxy Host allowlist; see docs/security.md.
security_allowed_origins:  # Usually empty; trusted proxy origins when required.

[moonraker]
moonraker_agent_enabled: true  # Local Unix socket registration and printer events.
moonraker_socket_path:  # Empty uses <printer_data_root>/comms/moonraker.sock.

[chat]
conversation_history_pairs: 10  # Previous user/assistant pairs sent with each request. Use 0 to disable. Examples: 0, 5, 10
memory_cross_chat: true  # Reuse dated evidence from other chats about this printer.
memory_retention_days: 90  # Retain application-owned investigation records for this many days.

[llm]
# These are defaults before the first Provider settings UI save. Saved provider
# policy/credentials take precedence; see docs/providers.md. Never put keys here.
# Installer sets private encrypted storage under data_dir/private via environment metadata.
# Direct development runs default to ~/.config/klipperai and require a master credential.
llm_provider: openai  # Chat and Debug require a configured API key.
openai_model: gpt-5.4-mini  # OpenAI model when provider = openai. Examples: gpt-5.4-mini, gpt-5.5

[agent]
agent_enabled: true  # Use iterative tool calling with the OpenAI provider.
web_search_enabled: true  # Allow public documentation search; uses provider credits.
web_search_domains:  # Optional comma-separated domains without https://.
agent_max_steps: 8
agent_max_tool_calls: 12
agent_tool_timeout_seconds: 30
agent_run_timeout_seconds: 180
agent_max_context_chars: 120000
agent_max_result_chars: 16000
agent_max_output_tokens: 6000

[logs]
collect_host_logs: true  # Whether to collect host logs. Examples: true, false
logs_dir_path: /home/pi/printer_data/logs  # Directory that contains printer-host logs. Examples: /home/pi/printer_data/logs, /srv/printer_data/logs
agent_log_file_name: klipperai.log  # Private runtime log filename under data_dir/logs. Examples: klipperai.log, ai-agent.log
agent_log_level: INFO  # Runtime log verbosity. Examples: INFO, DEBUG, WARNING
log_tail_lines_default: 100  # Default tail length when no override exists. Examples: 100, 200
excluded_logs:  # Comma-separated denylist by name, stem, or glob. Examples: klipperai.log, crowsnest, *_debug.log

[log_tail_lines]
klippy: 100  # Tail lines for klippy.log
moonraker: 200  # Tail lines for moonraker.log
klipperai: 100  # Tail lines for a legacy shared klipperai.log, if present.

[system]
collect_systemd_diagnostics: true  # Whether to collect systemctl and journal diagnostics. Examples: true, false
journal_lines: 200  # Journal lines to include per service. Examples: 100, 200, 400
additional_journal_units:  # Opt-in, at most six literal .service names. Example: crowsnest.service, nginx.service

[flight_recorder]
host_flight_recorder_enabled: false  # Opt-in Linux host history. Restart the agent after changing this setting.
host_flight_recorder_interval_seconds: 10  # 5-300 seconds; shorter sampling costs more host work and storage writes.
host_flight_recorder_max_samples: 1440  # 12-8640 samples; default approximately four hours, also limited by the byte budget.
